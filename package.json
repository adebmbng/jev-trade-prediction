{
  "name": "jev-trade",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'pnpm dev:api' 'pnpm dev:web'",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/api/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "lightweight-charts": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0"
  }
}
