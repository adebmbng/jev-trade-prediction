PORT=3001
HOST=127.0.0.1
# Optional backend overrides. Browser always connects directly to Binance.
BINANCE_REST=https://data-api.binance.vision
BINANCE_WS=wss://data-stream.binance.vision
# Compose host port; optional IP/CIDR list for a trusted reverse proxy.
APP_PORT=8080
TRUSTED_PROXIES=
# Server-only TypeSafe credential. No text-generation provider is required.
TYPESAFE_API_KEY=
# Nominal leverage supplied to Jev's risk context and prompt.
JEV_LEVERAGE=100
